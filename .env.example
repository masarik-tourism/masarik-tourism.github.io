# Optional: Google Gemini API key for server-side passport & document pre-check
GEMINI_API_KEY=

# Optional: Firebase Cloud Messaging Web Push VAPID public key (Settings > Cloud Messaging > Web Push certificates)
VITE_FIREBASE_VAPID_KEY=

# Optional: Firebase Service Account JSON string for background FCM HTTP v1 delivery when all browser tabs are closed
FCM_SERVICE_ACCOUNT_JSON=

