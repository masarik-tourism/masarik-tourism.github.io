rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared Hardened Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPhoneId(phoneId) {
      return phoneId is string && phoneId.size() >= 8 && phoneId.size() <= 20 && phoneId.matches('^[0-9]{8,20}$');
    }

    function isOptionalString(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    // Validation Blueprint: ClientProfile (/clients/{phoneId})
    function isValidClient(data, phoneId) {
      return data.keys().hasAll([
        'phone',
        'name',
        'otp',
        'verified',
        'createdAt',
        'orderStatus',
        'documents'
      ])
      && data.keys().hasOnly([
        'phone',
        'phoneNormalized',
        'orderCode',
        'accountType',
        'companyName',
        'contactPersonName',
        'isOnline',
        'lastSeenAt',
        'firstName',
        'lastName',
        'name',
        'avatarUrl',
        'avatarStoragePath',
        'avatarSizeBytes',
        'otp',
        'otpGeneratedAt',
        'otpExpiresAt',
        'otpConsumed',
        'activatedByAdmin',
        'adminBypassOtpAt',
        'pinHash',
        'pinUpdatedAt',
        'trustedDevices',
        'pendingLoginRequests',
        'pendingDevices',
        'activeSessions',
        'blockedDevices',
        'verified',
        'accountStatus',
        'verifiedAt',
        'createdAt',
        'updatedAt',
        'orderStatus',
        'adminNotes',
        'preferredVisaType',
        'passportNumber',
        'passportFullName',
        'passportExpiryDate',
        'nationality',
        'documents',
        'familyMembers',
        'issuedDocuments',
        'notifications',
        'appointmentDetails',
        'fcmToken',
        'fcmTokens',
        'fcmUpdatedAt',
        'pushNotificationsEnabled'
      ])
      && data.phone is string
      && data.phone == phoneId
      && data.phone.matches('^[0-9]{8,20}$')
      && isOptionalString(data, 'phoneNormalized', 20)
      && (!('phoneNormalized' in data) || (data.phoneNormalized.size() >= 8 && data.phoneNormalized.matches('^[0-9]{8,20}$') && data.phoneNormalized == phoneId))
      && isOptionalString(data, 'orderCode', 32)
      && (!('accountType' in data) || (data.accountType is string && data.accountType in ['individual', 'b2b_partner']))
      && isOptionalString(data, 'companyName', 160)
      && isOptionalString(data, 'contactPersonName', 120)
      && (!('isOnline' in data) || data.isOnline is bool)
      && isOptionalString(data, 'lastSeenAt', 64)
      && isOptionalString(data, 'firstName', 80)
      && isOptionalString(data, 'lastName', 80)
      && data.name is string
      && data.name.size() >= 1
      && data.name.size() <= 160
      && isOptionalString(data, 'avatarUrl', 4096)
      && isOptionalString(data, 'avatarStoragePath', 300)
      && (!('avatarSizeBytes' in data) || (data.avatarSizeBytes is int && data.avatarSizeBytes >= 0 && data.avatarSizeBytes <= 10485760))
      && data.otp is string
      && data.otp.matches('^[0-9]{6}$')
      && isOptionalString(data, 'otpGeneratedAt', 64)
      && isOptionalString(data, 'otpExpiresAt', 64)
      && (!('otpConsumed' in data) || data.otpConsumed is bool)
      && (!('activatedByAdmin' in data) || data.activatedByAdmin is bool)
      && isOptionalString(data, 'adminBypassOtpAt', 64)
      && data.verified is bool
      && (!('accountStatus' in data) || (data.accountStatus is string && data.accountStatus in ['pending_verification', 'verified']))
      && data.createdAt is string
      && data.createdAt.size() >= 10
      && data.createdAt.size() <= 64
      && data.orderStatus is string
      && data.orderStatus in [
        'تم استلام الطلب',
        'قيد المراجعة والتنفيذ',
        'تم الحجز / الإصدار',
        'تم تنفيذ الطلب',
        'مكتمل',
        'تم استلام الأوراق',
        'تم حجز موعد تساهيل',
        'تحت المراجعة',
        'صدرت التأشيرة'
      ]
      && isOptionalString(data, 'verifiedAt', 64)
      && isOptionalString(data, 'updatedAt', 64)
      && isOptionalString(data, 'adminNotes', 1000)
      && isOptionalString(data, 'preferredVisaType', 200)
      && isOptionalString(data, 'passportNumber', 40)
      && isOptionalString(data, 'passportFullName', 200)
      && isOptionalString(data, 'passportExpiryDate', 32)
      && isOptionalString(data, 'nationality', 100)
      && data.documents is list
      && data.documents.size() <= 30
      && (
        data.documents.size() == 0
        || (
          data.documents[0] is map
          && data.documents[0].id is string
          && data.documents[0].id.size() <= 80
          && data.documents[0].dataUrl is string
          && data.documents[0].dataUrl.size() <= 4096
          && (!('status' in data.documents[0]) || (data.documents[0].status is string && data.documents[0].status in ['pending_completion', 'received', 'completed']))
          && (!('statusNote' in data.documents[0]) || (data.documents[0].statusNote is string && data.documents[0].statusNote.size() <= 300))
          && (!('statusUpdatedAt' in data.documents[0]) || (data.documents[0].statusUpdatedAt is string && data.documents[0].statusUpdatedAt.size() <= 64))
        )
      )
      && (!('pinHash' in data) || (data.pinHash is string && data.pinHash.matches('^[a-f0-9]{64}$')))
      && isOptionalString(data, 'pinUpdatedAt', 64)
      && (
        !('trustedDevices' in data)
        || (
          data.trustedDevices is list
          && data.trustedDevices.size() <= 15
          && (
            data.trustedDevices.size() == 0
            || (
              data.trustedDevices[0] is map
              && data.trustedDevices[0].deviceId is string
              && data.trustedDevices[0].deviceId.size() >= 8
              && data.trustedDevices[0].deviceId.size() <= 64
              && data.trustedDevices[0].deviceId.matches('^[a-zA-Z0-9_\\-]+$')
              && data.trustedDevices[0].label is string
              && data.trustedDevices[0].label.size() <= 120
              && data.trustedDevices[0].addedAt is string
              && data.trustedDevices[0].addedAt.size() <= 64
              && data.trustedDevices[0].lastUsedAt is string
              && data.trustedDevices[0].lastUsedAt.size() <= 64
            )
          )
        )
      )
      && (
        !('pendingLoginRequests' in data)
        || (
          data.pendingLoginRequests is list
          && data.pendingLoginRequests.size() <= 10
          && (
            data.pendingLoginRequests.size() == 0
            || (
              data.pendingLoginRequests[0] is map
              && data.pendingLoginRequests[0].requestId is string
              && data.pendingLoginRequests[0].requestId.size() >= 6
              && data.pendingLoginRequests[0].requestId.size() <= 80
              && data.pendingLoginRequests[0].deviceId is string
              && data.pendingLoginRequests[0].deviceId.size() >= 8
              && data.pendingLoginRequests[0].deviceId.size() <= 64
              && data.pendingLoginRequests[0].deviceLabel is string
              && data.pendingLoginRequests[0].deviceLabel.size() <= 120
              && data.pendingLoginRequests[0].status is string
              && data.pendingLoginRequests[0].status in ['pending', 'approved', 'rejected', 'expired']
              && data.pendingLoginRequests[0].createdAt is string
              && data.pendingLoginRequests[0].createdAt.size() <= 64
              && data.pendingLoginRequests[0].expiresAt is string
              && data.pendingLoginRequests[0].expiresAt.size() <= 64
            )
          )
        )
      )
      && (
        !('pendingDevices' in data)
        || (
          data.pendingDevices is list
          && data.pendingDevices.size() <= 15
          && (
            data.pendingDevices.size() == 0
            || (
              data.pendingDevices[0] is map
              && data.pendingDevices[0].requestId is string
              && data.pendingDevices[0].requestId.size() >= 6
              && data.pendingDevices[0].requestId.size() <= 80
              && data.pendingDevices[0].deviceId is string
              && data.pendingDevices[0].deviceId.size() >= 8
              && data.pendingDevices[0].deviceId.size() <= 64
              && data.pendingDevices[0].deviceName is string
              && data.pendingDevices[0].deviceName.size() <= 120
              && data.pendingDevices[0].status is string
              && data.pendingDevices[0].status in ['pending', 'approved_trusted', 'approved_temporary', 'rejected', 'blocked', 'expired']
              && data.pendingDevices[0].createdAt is string
              && data.pendingDevices[0].createdAt.size() <= 64
              && data.pendingDevices[0].expiresAt is string
              && data.pendingDevices[0].expiresAt.size() <= 64
            )
          )
        )
      )
      && (
        !('activeSessions' in data)
        || (
          data.activeSessions is list
          && data.activeSessions.size() <= 20
          && (
            data.activeSessions.size() == 0
            || (
              data.activeSessions[0] is map
              && data.activeSessions[0].sessionId is string
              && data.activeSessions[0].sessionId.size() >= 6
              && data.activeSessions[0].sessionId.size() <= 100
              && data.activeSessions[0].deviceId is string
              && data.activeSessions[0].deviceId.size() >= 8
              && data.activeSessions[0].deviceId.size() <= 64
              && data.activeSessions[0].deviceName is string
              && data.activeSessions[0].deviceName.size() <= 120
              && data.activeSessions[0].mode is string
              && data.activeSessions[0].mode in ['trusted', 'temporary']
              && data.activeSessions[0].loggedInAt is string
              && data.activeSessions[0].loggedInAt.size() <= 64
              && data.activeSessions[0].lastActiveAt is string
              && data.activeSessions[0].lastActiveAt.size() <= 64
              && (!('expiresAt' in data.activeSessions[0]) || data.activeSessions[0].expiresAt == null || (data.activeSessions[0].expiresAt is string && data.activeSessions[0].expiresAt.size() <= 64))
            )
          )
        )
      )
      && (
        !('blockedDevices' in data)
        || (
          data.blockedDevices is list
          && data.blockedDevices.size() <= 25
          && (data.blockedDevices.size() == 0 || (data.blockedDevices[0] is string && data.blockedDevices[0].size() <= 64))
        )
      )
      && (
        !('familyMembers' in data)
        || (
          data.familyMembers is list
          && data.familyMembers.size() <= 25
          && (
            data.familyMembers.size() == 0
            || (
              data.familyMembers[0] is map
              && data.familyMembers[0].id is string
              && data.familyMembers[0].id.size() >= 1
              && data.familyMembers[0].id.size() <= 80
              && data.familyMembers[0].relationship is string
              && data.familyMembers[0].relationship in ['spouse', 'child', 'parent', 'sibling', 'other']
              && data.familyMembers[0].firstName is string
              && data.familyMembers[0].firstName.size() <= 80
              && data.familyMembers[0].lastName is string
              && data.familyMembers[0].lastName.size() <= 80
              && data.familyMembers[0].passportNumber is string
              && data.familyMembers[0].passportNumber.size() <= 40
              && data.familyMembers[0].passportPhotoUrl is string
              && data.familyMembers[0].passportPhotoUrl.size() <= 4096
              && data.familyMembers[0].personalPhotoUrl is string
              && data.familyMembers[0].personalPhotoUrl.size() <= 4096
            )
          )
        )
      )
      && (
        !('issuedDocuments' in data)
        || (
          data.issuedDocuments is list
          && data.issuedDocuments.size() <= 30
          && (
            data.issuedDocuments.size() == 0
            || (
              data.issuedDocuments[0] is map
              && data.issuedDocuments[0].id is string
              && data.issuedDocuments[0].id.size() >= 1
              && data.issuedDocuments[0].id.size() <= 80
              && data.issuedDocuments[0].docTypeLabel is string
              && data.issuedDocuments[0].docTypeLabel.size() >= 1
              && data.issuedDocuments[0].docTypeLabel.size() <= 160
              && data.issuedDocuments[0].fileName is string
              && data.issuedDocuments[0].fileName.size() <= 220
              && data.issuedDocuments[0].mimeType is string
              && data.issuedDocuments[0].mimeType.size() <= 120
              && data.issuedDocuments[0].downloadUrl is string
              && data.issuedDocuments[0].downloadUrl.size() <= 4096
              && data.issuedDocuments[0].issuedAt is string
              && data.issuedDocuments[0].issuedAt.size() <= 64
            )
          )
        )
      )
      && (
        !('notifications' in data)
        || (
          data.notifications is list
          && data.notifications.size() <= 30
          && (
            data.notifications.size() == 0
            || (
              data.notifications[0] is map
              && data.notifications[0].id is string
              && data.notifications[0].id.size() >= 1
              && data.notifications[0].id.size() <= 80
              && data.notifications[0].titleAr is string
              && data.notifications[0].titleAr.size() <= 160
              && data.notifications[0].titleEn is string
              && data.notifications[0].titleEn.size() <= 160
              && data.notifications[0].bodyAr is string
              && data.notifications[0].bodyAr.size() <= 400
              && data.notifications[0].bodyEn is string
              && data.notifications[0].bodyEn.size() <= 400
              && data.notifications[0].type is string
              && data.notifications[0].type in ['deliverable', 'status']
              && data.notifications[0].createdAt is string
              && data.notifications[0].createdAt.size() <= 64
              && data.notifications[0].read is bool
            )
          )
        )
      )
      && (
        !('appointmentDetails' in data)
        || (
          data.appointmentDetails is map
          && data.appointmentDetails.keys().hasOnly([
            'serviceType',
            'appointmentDate',
            'appointmentTime',
            'location',
            'referenceNumber',
            'updatedAt'
          ])
          && data.appointmentDetails.serviceType is string
          && data.appointmentDetails.serviceType.size() <= 160
          && data.appointmentDetails.appointmentDate is string
          && data.appointmentDetails.appointmentDate.size() <= 40
          && data.appointmentDetails.appointmentTime is string
          && data.appointmentDetails.appointmentTime.size() <= 40
          && isOptionalString(data.appointmentDetails, 'location', 200)
          && isOptionalString(data.appointmentDetails, 'referenceNumber', 80)
          && isOptionalString(data.appointmentDetails, 'updatedAt', 64)
        )
      )
      && isOptionalString(data, 'fcmToken', 512)
      && (
        !('fcmTokens' in data)
        || (
          data.fcmTokens is list
          && data.fcmTokens.size() <= 10
          && (data.fcmTokens.size() == 0 || (data.fcmTokens[0] is string && data.fcmTokens[0].size() <= 512))
        )
      )
      && isOptionalString(data, 'fcmUpdatedAt', 64)
      && (!('pushNotificationsEnabled' in data) || data.pushNotificationsEnabled is bool);
    }

    // Validation Blueprint: SiteGeneralConfig (/site_config/general)
    function isValidSiteGeneral(data) {
      return data.keys().hasAll([
        'announcementEnabled',
        'announcementTextAr',
        'announcementTextEn',
        'announcementStyle',
        'phoneNumber',
        'workingHoursAr',
        'workingHoursEn',
        'heroHighlightAr',
        'heroHighlightEn'
      ])
      && data.keys().hasOnly([
        'announcementEnabled',
        'announcementTextAr',
        'announcementTextEn',
        'announcementStyle',
        'phoneNumber',
        'workingHoursAr',
        'workingHoursEn',
        'heroHighlightAr',
        'heroHighlightEn',
        'primaryDriveWebAppUrl',
        'additionalDriveWebApps',
        'fcmVapidKey',
        'retentionDays',
        'updatedAt'
      ])
      && data.announcementEnabled is bool
      && data.announcementTextAr is string && data.announcementTextAr.size() <= 500
      && data.announcementTextEn is string && data.announcementTextEn.size() <= 500
      && data.announcementStyle is string && data.announcementStyle in ['gold', 'red', 'green']
      && data.phoneNumber is string && data.phoneNumber.size() <= 40
      && data.workingHoursAr is string && data.workingHoursAr.size() <= 200
      && data.workingHoursEn is string && data.workingHoursEn.size() <= 200
      && data.heroHighlightAr is string && data.heroHighlightAr.size() <= 500
      && data.heroHighlightEn is string && data.heroHighlightEn.size() <= 500
      && (!('primaryDriveWebAppUrl' in data) || (data.primaryDriveWebAppUrl is string && data.primaryDriveWebAppUrl.size() <= 500 && data.primaryDriveWebAppUrl.matches('^https://.*')))
      && (
        !('additionalDriveWebApps' in data)
        || (
          data.additionalDriveWebApps is list
          && data.additionalDriveWebApps.size() <= 10
          && (
            data.additionalDriveWebApps.size() == 0
            || (
              data.additionalDriveWebApps[0] is map
              && data.additionalDriveWebApps[0].keys().hasAll(['id', 'label', 'url', 'scope', 'enabled'])
              && data.additionalDriveWebApps[0].keys().hasOnly(['id', 'label', 'url', 'scope', 'enabled'])
              && data.additionalDriveWebApps[0].id is string
              && data.additionalDriveWebApps[0].id.size() >= 1
              && data.additionalDriveWebApps[0].id.size() <= 64
              && data.additionalDriveWebApps[0].label is string
              && data.additionalDriveWebApps[0].label.size() <= 120
              && data.additionalDriveWebApps[0].url is string
              && data.additionalDriveWebApps[0].url.size() <= 500
              && data.additionalDriveWebApps[0].url.matches('^https://.*')
              && data.additionalDriveWebApps[0].scope is string
              && data.additionalDriveWebApps[0].scope in ['all', 'client_docs', 'admin_deliverables']
              && data.additionalDriveWebApps[0].enabled is bool
            )
          )
        )
      )
      && isOptionalString(data, 'fcmVapidKey', 256)
      && (!('retentionDays' in data) || (data.retentionDays is int && data.retentionDays in [30, 60, 90]))
      && isOptionalString(data, 'updatedAt', 64);
    }

    // Validation Blueprint: SiteCmsState (/site_config/cms)
    function isValidSiteCms(data) {
      return data.keys().hasAll(['textOverrides', 'deletedKeys', 'customItems'])
      && data.keys().hasOnly(['textOverrides', 'deletedKeys', 'customItems', 'updatedAt'])
      && data.textOverrides is map
      && data.textOverrides.size() <= 500
      && data.deletedKeys is list
      && data.deletedKeys.size() <= 200
      && (data.deletedKeys.size() == 0 || (data.deletedKeys[0] is string && data.deletedKeys[0].size() <= 200))
      && data.customItems is list
      && data.customItems.size() <= 100
      && (data.customItems.size() == 0 || (data.customItems[0] is map && data.customItems[0].id is string && data.customItems[0].id.size() <= 80))
      && isOptionalString(data, 'updatedAt', 64);
    }

    // Validation Blueprint: AdminAccount (/admins/{adminId})
    function isValidAdminAccount(data, adminId) {
      return data.keys().hasAll(['id', 'role', 'name', 'pinHash', 'permissions'])
      && data.keys().hasOnly([
        'id',
        'role',
        'name',
        'pinHash',
        'pin',
        'permissions',
        'fcmToken',
        'fcmTokens',
        'fcmUpdatedAt',
        'pushNotificationsEnabled',
        'createdAt',
        'updatedAt'
      ])
      && data.id is string
      && data.id == adminId
      && isValidId(data.id)
      && data.role is string
      && data.role in ['super_admin', 'sub_admin']
      && data.name is string
      && data.name.size() >= 1
      && data.name.size() <= 120
      && data.pinHash is string
      && data.pinHash.matches('^[a-f0-9]{64}$')
      && isOptionalString(data, 'pin', 32)
      && isOptionalString(data, 'fcmToken', 512)
      && (
        !('fcmTokens' in data)
        || (
          data.fcmTokens is list
          && data.fcmTokens.size() <= 10
          && (data.fcmTokens.size() == 0 || (data.fcmTokens[0] is string && data.fcmTokens[0].size() <= 512))
        )
      )
      && isOptionalString(data, 'fcmUpdatedAt', 64)
      && (!('pushNotificationsEnabled' in data) || data.pushNotificationsEnabled is bool)
      && isOptionalString(data, 'createdAt', 64)
      && isOptionalString(data, 'updatedAt', 64)
      && data.permissions is list
      && data.permissions.size() <= 10
      && (data.permissions.size() == 0 || data.permissions[0] is string);
    }

    // Startup Connectivity Check (/test/connection)
    match /test/{docId} {
      allow get: if docId == 'connection';
    }

    // Traveler Clients Collection
    match /clients/{phoneId} {
      allow get: if isValidPhoneId(phoneId);
      allow list: if resource.data.verified in [true, false];
      allow create: if isValidPhoneId(phoneId) && isValidClient(incoming(), phoneId);
      allow update: if isValidPhoneId(phoneId)
        && isValidClient(incoming(), phoneId)
        && incoming().phone == existing().phone
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'phoneNormalized',
          'orderCode',
          'accountType',
          'companyName',
          'contactPersonName',
          'isOnline',
          'lastSeenAt',
          'firstName',
          'lastName',
          'name',
          'avatarUrl',
          'avatarStoragePath',
          'avatarSizeBytes',
          'otp',
          'otpGeneratedAt',
          'otpExpiresAt',
          'otpConsumed',
          'activatedByAdmin',
          'adminBypassOtpAt',
          'pinHash',
          'pinUpdatedAt',
          'trustedDevices',
          'pendingLoginRequests',
          'pendingDevices',
          'activeSessions',
          'blockedDevices',
          'verified',
          'accountStatus',
          'verifiedAt',
          'updatedAt',
          'orderStatus',
          'adminNotes',
          'preferredVisaType',
          'passportNumber',
          'passportFullName',
          'passportExpiryDate',
          'nationality',
          'documents',
          'familyMembers',
          'issuedDocuments',
          'notifications',
          'appointmentDetails',
          'fcmToken',
          'fcmTokens',
          'fcmUpdatedAt',
          'pushNotificationsEnabled'
        ]);
      allow delete: if isValidPhoneId(phoneId) && resource != null;
    }

    // Validation Blueprint: Public Non-PII OrderStatusLookup (/order_status/{phoneId})
    function isValidOrderStatusLookup(data, phoneId) {
      return data.keys().hasAll([
        'phoneId',
        'orderCode',
        'orderStatus',
        'hasIssuedDocuments',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'phoneId',
        'orderCode',
        'orderStatus',
        'hasIssuedDocuments',
        'updatedAt'
      ])
      && data.phoneId is string
      && data.phoneId == phoneId
      && data.phoneId.matches('^[0-9]{8,20}$')
      && data.orderCode is string
      && data.orderCode.size() >= 3
      && data.orderCode.size() <= 32
      && data.orderStatus is string
      && data.orderStatus in [
        'تم استلام الطلب',
        'قيد المراجعة والتنفيذ',
        'تم الحجز / الإصدار',
        'تم تنفيذ الطلب',
        'مكتمل',
        'تم استلام الأوراق',
        'تم حجز موعد تساهيل',
        'تحت المراجعة',
        'صدرت التأشيرة'
      ]
      && data.hasIssuedDocuments is bool
      && data.updatedAt is string
      && data.updatedAt.size() <= 64;
    }

    // Public Non-PII Order Status Lookup Collection
    match /order_status/{phoneId} {
      allow get: if isValidPhoneId(phoneId);
      allow list: if resource.data.orderCode is string;
      allow create, update: if isValidPhoneId(phoneId) && isValidOrderStatusLookup(incoming(), phoneId);
      allow delete: if isValidPhoneId(phoneId) && resource != null;
    }

    // Public Site Configuration & Live Inline CMS
    match /site_config/{configId} {
      allow get: if configId in ['general', 'cms'];
      allow list: if resource.data.updatedAt is string;
      allow create, update: if (
        (configId == 'general' && isValidSiteGeneral(incoming()))
        || (configId == 'cms' && isValidSiteCms(incoming()))
      );
      allow delete: if false;
    }

    // Admin & Sub-Admin Accounts
    match /admins/{adminId} {
      allow get: if isValidId(adminId);
      allow list: if resource.data.role in ['super_admin', 'sub_admin'];
      allow create: if isValidId(adminId) && isValidAdminAccount(incoming(), adminId);
      allow update: if isValidId(adminId)
        && isValidAdminAccount(incoming(), adminId)
        && incoming().id == existing().id
        && incoming().role == existing().role
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'pinHash',
          'pin',
          'permissions',
          'fcmToken',
          'fcmTokens',
          'fcmUpdatedAt',
          'pushNotificationsEnabled',
          'updatedAt'
        ]);
      allow delete: if isValidId(adminId) && adminId != 'master' && resource != null;
    }

    // Validation Blueprint: NotificationSettings (/settings/notifications)
    function isValidNotificationSettings(data) {
      return data.keys().hasAll(['adminFcmTokens', 'updatedAt'])
      && data.keys().hasOnly(['adminFcmTokens', 'updatedAt'])
      && data.adminFcmTokens is list
      && data.adminFcmTokens.size() <= 20
      && (
        data.adminFcmTokens.size() == 0
        || (
          data.adminFcmTokens[0] is string
          && data.adminFcmTokens[0].size() >= 10
          && data.adminFcmTokens[0].size() <= 512
        )
      )
      && data.updatedAt is string
      && data.updatedAt.size() <= 64;
    }

    // Canonical Global Notification Settings Document (/settings/notifications)
    match /settings/{settingId} {
      allow get: if settingId == 'notifications';
      allow list: if resource.data.updatedAt is string;
      allow create, update: if settingId == 'notifications'
        && isValidNotificationSettings(incoming());
      allow delete: if false;
    }

    // Validation Blueprint: DeviceApproval (/deviceApprovals/{requestId})
    function isValidDeviceApproval(data, requestId) {
      return data.keys().hasAll([
        'requestId',
        'phoneId',
        'deviceId',
        'deviceName',
        'status',
        'createdAt',
        'expiresAt'
      ])
      && data.keys().hasOnly([
        'requestId',
        'phoneId',
        'deviceId',
        'deviceName',
        'status',
        'approvalMode',
        'temporaryDurationHours',
        'createdAt',
        'expiresAt',
        'respondedAt'
      ])
      && data.requestId is string
      && data.requestId == requestId
      && isValidId(data.requestId)
      && data.requestId.size() >= 6
      && data.requestId.size() <= 80
      && isValidPhoneId(data.phoneId)
      && data.deviceId is string
      && data.deviceId.size() >= 8
      && data.deviceId.size() <= 64
      && data.deviceId.matches('^[a-zA-Z0-9_\\-]+$')
      && data.deviceName is string
      && data.deviceName.size() >= 1
      && data.deviceName.size() <= 120
      && data.status is string
      && data.status in ['pending', 'approved_trusted', 'approved_temporary', 'rejected', 'blocked', 'expired']
      && (!('approvalMode' in data) || (data.approvalMode is string && data.approvalMode in ['trusted', 'temporary']))
      && (!('temporaryDurationHours' in data) || (data.temporaryDurationHours is number && data.temporaryDurationHours >= 1 && data.temporaryDurationHours <= 24))
      && data.createdAt is string
      && data.createdAt.size() <= 64
      && data.expiresAt is string
      && data.expiresAt.size() <= 64
      && isOptionalString(data, 'respondedAt', 64);
    }

    // Cross-Device Login Approval Requests (/deviceApprovals/{requestId})
    match /deviceApprovals/{requestId} {
      allow get: if isValidId(requestId);
      allow list: if resource.data.status in ['pending', 'approved_trusted', 'approved_temporary', 'rejected', 'blocked', 'expired'];
      allow create: if isValidId(requestId)
        && isValidDeviceApproval(incoming(), requestId);
      allow update: if isValidId(requestId)
        && isValidDeviceApproval(incoming(), requestId)
        && incoming().requestId == existing().requestId
        && incoming().phoneId == existing().phoneId
        && incoming().deviceId == existing().deviceId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status',
          'approvalMode',
          'temporaryDurationHours',
          'expiresAt',
          'respondedAt'
        ]);
      allow delete: if isValidId(requestId) && resource != null;
    }

    // Validation Blueprint: ChatThread (/chats/{phoneId})
    function isValidChatThread(data, phoneId) {
      return data.keys().hasAll([
        'phoneId',
        'lastMessageText',
        'lastMessageAt',
        'lastSenderRole',
        'unreadAdminCount',
        'unreadClientCount',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'phoneId',
        'accountType',
        'clientName',
        'companyName',
        'lastMessageText',
        'lastMessageAt',
        'lastSenderRole',
        'unreadAdminCount',
        'unreadClientCount',
        'updatedAt'
      ])
      && data.phoneId is string
      && data.phoneId == phoneId
      && data.phoneId.matches('^[0-9]{8,20}$')
      && (!('accountType' in data) || (data.accountType is string && data.accountType in ['individual', 'b2b_partner']))
      && isOptionalString(data, 'clientName', 160)
      && isOptionalString(data, 'companyName', 160)
      && data.lastMessageText is string
      && data.lastMessageText.size() <= 500
      && data.lastMessageAt is string
      && data.lastMessageAt.size() <= 64
      && data.lastSenderRole is string
      && data.lastSenderRole in ['admin', 'client']
      && data.unreadAdminCount is int
      && data.unreadAdminCount >= 0
      && data.unreadAdminCount <= 9999
      && data.unreadClientCount is int
      && data.unreadClientCount >= 0
      && data.unreadClientCount <= 9999
      && data.updatedAt is string
      && data.updatedAt.size() <= 64;
    }

    // Validation Blueprint: ChatMessage (/chats/{phoneId}/messages/{messageId})
    function isValidChatMessage(data, phoneId, messageId) {
      return data.keys().hasAll([
        'id',
        'phoneId',
        'senderRole',
        'senderName',
        'text',
        'attachments',
        'messageType',
        'readByAdmin',
        'readByClient',
        'createdAt'
      ])
      && data.keys().hasOnly([
        'id',
        'phoneId',
        'senderRole',
        'senderName',
        'text',
        'attachments',
        'messageType',
        'readByAdmin',
        'readByClient',
        'createdAt'
      ])
      && data.id is string
      && data.id == messageId
      && isValidId(data.id)
      && data.phoneId is string
      && data.phoneId == phoneId
      && data.phoneId.matches('^[0-9]{8,20}$')
      && data.senderRole is string
      && data.senderRole in ['admin', 'client']
      && data.senderName is string
      && data.senderName.size() >= 1
      && data.senderName.size() <= 160
      && data.text is string
      && data.text.size() <= 4000
      && data.attachments is list
      && data.attachments.size() <= 10
      && (
        data.attachments.size() == 0
        || (
          data.attachments[0] is map
          && data.attachments[0].id is string
          && data.attachments[0].id.size() <= 80
          && data.attachments[0].fileName is string
          && data.attachments[0].fileName.size() <= 220
          && data.attachments[0].mimeType is string
          && data.attachments[0].mimeType.size() <= 120
          && data.attachments[0].downloadUrl is string
          && data.attachments[0].downloadUrl.size() <= 4096
        )
      )
      && data.messageType is string
      && data.messageType in ['text', 'files', 'status_notice', 'quick_reply']
      && data.readByAdmin is bool
      && data.readByClient is bool
      && data.createdAt is string
      && data.createdAt.size() <= 64;
    }

    // Isolated Real-Time Private Chat Threads & Messages Subcollection
    match /chats/{phoneId} {
      allow get: if isValidPhoneId(phoneId);
      allow list: if resource.data.lastSenderRole in ['admin', 'client'];
      allow create, update: if isValidPhoneId(phoneId)
        && exists(/databases/$(database)/documents/clients/$(phoneId))
        && isValidChatThread(incoming(), phoneId);
      allow delete: if isValidPhoneId(phoneId) && resource != null;

      match /messages/{messageId} {
        allow get: if isValidPhoneId(phoneId) && isValidId(messageId);
        allow list: if isValidPhoneId(phoneId)
          && resource.data.phoneId == phoneId;
        allow create: if isValidPhoneId(phoneId)
          && isValidId(messageId)
          && exists(/databases/$(database)/documents/clients/$(phoneId))
          && isValidChatMessage(incoming(), phoneId, messageId);
        allow update: if isValidPhoneId(phoneId)
          && isValidId(messageId)
          && isValidChatMessage(incoming(), phoneId, messageId)
          && incoming().id == existing().id
          && incoming().phoneId == existing().phoneId
          && incoming().senderRole == existing().senderRole
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['readByAdmin', 'readByClient']);
        allow delete: if isValidPhoneId(phoneId) && isValidId(messageId) && resource != null;
      }
    }
  }
}
